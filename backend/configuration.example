# CORS only needs explicit frontend origins when calling FastAPI directly.
# Same-origin /api proxy access works over LAN without additional origins.
CORS_ORIGINS=["http://localhost:8443","http://127.0.0.1:8443","http://localhost:5173","http://127.0.0.1:5173"]

# Copy to backend/.env and replace placeholders locally. Never commit .env.
DATABASE_URL=postgresql+asyncpg://postgres:<database-password>@127.0.0.1:5432/canteen_db
POSTGRES_PASSWORD=<same-database-password>
SECRET_KEY=<generate-a-random-signing-secret>
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=<choose-an-admin-password>
