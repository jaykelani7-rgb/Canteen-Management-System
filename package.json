{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm run admin",
    "build": "pnpm run build:admin && pnpm run build:student",
    "preview": "pnpm run preview:admin",
    "format": "oxfmt",
    "test:separation": "node scripts/check-separation.cjs --built",
    "admin": "vite --host 0.0.0.0 --port 8443",
    "student": "vite --config vite.student.config.ts --host 0.0.0.0 --port 5173",
    "build:admin": "vite build",
    "build:student": "vite build --config vite.student.config.ts",
    "preview:admin": "vite preview --host 0.0.0.0 --port 8443",
    "preview:student": "vite preview --config vite.student.config.ts --host 0.0.0.0 --port 5173",
    "build:student:android": "node scripts/build-student-android.mjs",
    "android:sync": "pnpm run build:student:android && pnpm exec cap sync android",
    "android:open": "pnpm exec cap open android",
    "android:debug": "pnpm run android:sync && node scripts/build-android-debug.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "test:pages": "node scripts/check-pages-build.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0"
  }
}
